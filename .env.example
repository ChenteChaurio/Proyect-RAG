# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del proyecto RAG
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# Groq ────────────────────────────────────────────────────────────────────────
# Obtén tu clave gratis en https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Modelo LLM de Groq para generar respuestas
# Opciones gratuitas: llama-3.3-70b-versatile | llama-3.1-8b-instant | gemma2-9b-it
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Pinecone ────────────────────────────────────────────────────────────────────
# Obtén tu clave en https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key

# Nombre del índice Pinecone (se crea automáticamente si no existe)
# IMPORTANTE: la dimensión debe coincidir con el modelo de embeddings (384)
PINECONE_INDEX_NAME=rag-groq-demo

# User-agent para peticiones HTTP (evita advertencias de WebBaseLoader)
USER_AGENT=RAG-LangChain-Demo/1.0

# LangSmith (opcional – habilita trazas de ejecución) ────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=tu-clave-langsmith
